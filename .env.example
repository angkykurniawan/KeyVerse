# =============================================================================
# KeyVerse - Konfigurasi Confidential (.env)
# =============================================================================
# Salin file ini menjadi .env (atau api/.env saat deploy ke InfinityFree)
# dan isi nilai yang sesuai. JANGAN pernah commit file .env ke Git!

APP_ENV=local
APP_DEBUG=false
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Untuk InfinityFree (Production): gunakan DB_DRIVER=mysql dan isi kredensial
# dari Control Panel InfinityFree -> MySQL Databases.
# Untuk pengembangan lokal tanpa MySQL: gunakan DB_DRIVER=sqlite
DB_DRIVER=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_NAME=if0_xxxxxxxx_keyverse
DB_USER=if0_xxxxxxxx
DB_PASS=your_infinityfree_db_password

# Hanya digunakan jika DB_DRIVER=sqlite (otomatis dibuat di api/storage/)
DB_SQLITE_PATH=storage/keyverse.sqlite

# -----------------------------------------------------------------------------
# JWT Authentication Secret
# -----------------------------------------------------------------------------
# Ganti dengan string acak panjang minimal 32 karakter!
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars
JWT_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Google AI Studio (Gemini API)
# -----------------------------------------------------------------------------
# Masukkan API key dari https://aistudio.google.com/apikey
# Daftar model AI akan otomatis diambil sesuai API key yang aktif.
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# -----------------------------------------------------------------------------
# Akun Admin Awal (digunakan saat inisialisasi pertama kali)
# -----------------------------------------------------------------------------
ADMIN_INIT_NAME=Administrator
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_EMAIL=admin@keyverse.local
ADMIN_INIT_PASSWORD=AdminKeyVerse123!

# -----------------------------------------------------------------------------
# Frontend Vite (opsional; default '/api' untuk single-origin / InfinityFree)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api
